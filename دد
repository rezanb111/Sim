<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>صادرات به آفریقا - سیما خورشیدیان</title>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Vazirmatn', sans-serif;
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
            color: #fff;
            overflow-x: hidden;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        /* Header با طراحی خاص */
        .header {
            background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
            padding: 30px;
            border-radius: 30px;
            border: 3px solid #d4af37;
            box-shadow: 0 20px 60px rgba(212, 175, 55, 0.3);
            margin-bottom: 40px;
            position: relative;
            overflow: hidden;
        }

        .header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, transparent 70%);
            animation: rotate 20s linear infinite;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .header-content {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 30px;
        }

        .header-text {
            flex: 1;
            min-width: 300px;
        }

        .header h1 {
            font-size: 3.5em;
            font-weight: 900;
            background: linear-gradient(135deg, #d4af37 0%, #f8e45f 50%, #d4af37 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 15px;
            text-shadow: 0 0 30px rgba(212, 175, 55, 0.5);
            animation: shimmer 3s ease-in-out infinite;
        }

        @keyframes shimmer {
            0%, 100% { filter: brightness(1); }
            50% { filter: brightness(1.3); }
        }

        .header h2 {
            font-size: 1.8em;
            color: #4ecca3;
            font-weight: 500;
            margin-bottom: 10px;
        }

        .author-badge {
            display: inline-block;
            background: linear-gradient(135deg, #d4af37 0%, #f8e45f 100%);
            color: #000;
            padding: 12px 30px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1.2em;
            box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
            margin-top: 15px;
        }

        .header-image {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            border: 5px solid #d4af37;
            box-shadow: 0 0 40px rgba(212, 175, 55, 0.6);
            object-fit: cover;
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }

        /* دکمه دانلود */
        .download-btn {
            position: fixed;
            top: 20px;
            left: 20px;
            background: linear-gradient(135deg, #d4af37 0%, #f8e45f 100%);
            color: #000;
            padding: 15px 30px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1.1em;
            text-decoration: none;
            box-shadow: 0 10px 30px rgba(212, 175, 55, 0.5);
            z-index: 1000;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .download-btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(212, 175, 55, 0.7);
        }

        /* Navigation */
        .nav-container {
            background: rgba(26, 26, 26, 0.9);
            backdrop-filter: blur(10px);
            padding: 20px;
            border-radius: 20px;
            margin-bottom: 40px;
            border: 2px solid #d4af37;
            position: sticky;
            top: 20px;
            z-index: 100;
        }

        .nav {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .nav-btn {
            background: linear-gradient(135deg, #2d2d2d 0%, #1a1a1a 100%);
            color: #d4af37;
            border: 2px solid #d4af37;
            padding: 12px 25px;
            border-radius: 15px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            font-size: 1em;
        }

        .nav-btn:hover, .nav-btn.active {
            background: linear-gradient(135deg, #d4af37 0%, #f8e45f 100%);
            color: #000;
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(212, 175, 55, 0.4);
        }

        /* Slides */
        .slide {
            display: none;
            animation: fadeIn 0.8s ease;
        }

        .slide.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Card Design */
        .card {
            background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
            border-radius: 25px;
            padding: 40px;
            margin-bottom: 30px;
            border: 3px solid transparent;
            background-clip: padding-box;
            position: relative;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.5);
            transition: all 0.4s ease;
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            border-radius: 25px;
            padding: 3px;
            background: linear-gradient(135deg, #d4af37, #4ecca3, #d4af37);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .card:hover::before {
            opacity: 1;
        }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 25px 70px rgba(212, 175, 55, 0.3);
        }

        .card-title {
            font-size: 2.5em;
            font-weight: 800;
            color: #d4af37;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .card-title::before {
            content: '';
            width: 8px;
            height: 60px;
            background: linear-gradient(180deg, #d4af37 0%, #4ecca3 100%);
            border-radius: 10px;
        }

        /* Content Sections */
        .content-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            margin: 30px 0;
        }

        .info-box {
            background: rgba(212, 175, 55, 0.1);
            border: 2px solid #d4af37;
            border-radius: 20px;
            padding: 25px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .info-box::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.2) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .info-box:hover::before {
            opacity: 1;
        }

        .info-box:hover {
            transform: scale(1.05);
            box-shadow: 0 15px 40px rgba(212, 175, 55, 0.3);
        }

        .info-box h3 {
            color: #4ecca3;
            font-size: 1.5em;
            margin-bottom: 15px;
            font-weight: 700;
        }

        .info-box p {
            color: #ccc;
            line-height: 1.8;
            font-size: 1.05em;
        }

        /* Circular Notes */
        .circular-note {
            position: absolute;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: linear-gradient(135deg, #d4af37 0%, #f8e45f 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 15px;
            font-size: 0.75em;
            font-weight: 700;
            color: #000;
            box-shadow: 0 10px 30px rgba(212, 175, 55, 0.5);
            animation: pulse 2s ease-in-out infinite;
            z-index: 10;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .note-top-right {
            top: -40px;
            right: -40px;
        }

        .note-bottom-left {
            bottom: -40px;
            left: -40px;
        }

        /* List Styling */
        .styled-list {
            list-style: none;
            padding: 0;
        }

                .styled-list li {
            background: linear-gradient(90deg, rgba(212, 175, 55, 0.2) 0%, transparent 100%);
            border-right: 4px solid #4ecca3;
            padding: 15px 20px;
            margin-bottom: 15px;
            border-radius: 10px;
            transition: all 0.3s ease;
            position: relative;
        }

        .styled-list li:hover {
            background: linear-gradient(90deg, rgba(212, 175, 55, 0.3) 0%, rgba(78, 204, 163, 0.1) 100%);
            transform: translateX(-10px);
            border-right-width: 6px;
        }

        .styled-list li::before {
            content: '◆';
            color: #d4af37;
            font-size: 1.2em;
            margin-left: 10px;
            font-weight: bold;
        }

        /* Image Gallery */
        .image-gallery {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin: 30px 0;
        }

        .gallery-item {
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            border: 3px solid #d4af37;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            transition: all 0.4s ease;
        }

        .gallery-item:hover {
            transform: scale(1.05) rotate(2deg);
            box-shadow: 0 20px 50px rgba(212, 175, 55, 0.5);
        }

        .gallery-item img {
            width: 100%;
            height: 300px;
            object-fit: cover;
            transition: all 0.4s ease;
        }

        .gallery-item:hover img {
            transform: scale(1.1);
        }

        .gallery-caption {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.9), transparent);
            padding: 20px;
            color: #d4af37;
            font-weight: 700;
            transform: translateY(100%);
            transition: transform 0.4s ease;
        }

        .gallery-item:hover .gallery-caption {
            transform: translateY(0);
        }

        /* Stats Box */
        .stats-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin: 30px 0;
        }

        .stat-box {
            background: linear-gradient(135deg, #2d2d2d 0%, #1a1a1a 100%);
            border: 2px solid #4ecca3;
            border-radius: 20px;
            padding: 30px;
            text-align: center;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .stat-box::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(78, 204, 163, 0.3), transparent);
            transition: left 0.5s ease;
        }

        .stat-box:hover::before {
            left: 100%;
        }

        .stat-box:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 40px rgba(78, 204, 163, 0.4);
        }

        .stat-number {
            font-size: 3em;
            font-weight: 900;
            color: #d4af37;
            margin-bottom: 10px;
        }

        .stat-label {
            font-size: 1.1em;
            color: #4ecca3;
            font-weight: 600;
        }

        /* Quote Box */
        .quote-box {
            background: linear-gradient(135deg, rgba(212, 175, 55, 0.15) 0%, rgba(78, 204, 163, 0.15) 100%);
            border-right: 6px solid #d4af37;
            border-radius: 15px;
            padding: 30px;
            margin: 30px 0;
            font-size: 1.3em;
            font-style: italic;
            color: #f8e45f;
            position: relative;
        }

        .quote-box::before {
            content: '"';
            font-size: 5em;
            color: rgba(212, 175, 55, 0.3);
            position: absolute;
            top: -20px;
            right: 20px;
            font-family: Georgia, serif;
        }

        /* Country Cards */
        .country-card {
            background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
            border-radius: 25px;
            padding: 35px;
            margin-bottom: 30px;
            border: 3px solid #4ecca3;
            position: relative;
            overflow: hidden;
            transition: all 0.4s ease;
        }

        .country-card::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 150px;
            height: 150px;
            background: radial-gradient(circle, rgba(78, 204, 163, 0.2) 0%, transparent 70%);
            border-radius: 50%;
            transform: translate(50%, -50%);
        }

        .country-card:hover {
            transform: translateX(-10px);
            box-shadow: 0 20px 60px rgba(78, 204, 163, 0.3);
        }

        .country-title {
            font-size: 2.2em;
            color: #d4af37;
            font-weight: 800;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .country-flag {
            font-size: 1.5em;
        }

        .country-content {
            color: #ccc;
            line-height: 1.9;
            font-size: 1.1em;
        }

        .country-highlights {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .highlight-item {
            background: rgba(212, 175, 55, 0.1);
            border: 1px solid #d4af37;
            border-radius: 12px;
            padding: 15px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .highlight-item:hover {
            background: rgba(212, 175, 55, 0.2);
            transform: scale(1.05);
        }

        .highlight-icon {
            font-size: 2em;
            margin-bottom: 10px;
        }

        /* Q&A Section */
        .qa-container {
            margin: 30px 0;
        }

        .qa-item {
            background: linear-gradient(135deg, #2d2d2d 0%, #1a1a1a 100%);
            border-radius: 20px;
            margin-bottom: 20px;
            overflow: hidden;
            border: 2px solid #4ecca3;
            transition: all 0.3s ease;
        }

        .qa-item:hover {
            box-shadow: 0 15px 40px rgba(78, 204, 163, 0.3);
        }

        .question {
            background: linear-gradient(90deg, #d4af37 0%, #f8e45f 100%);
            color: #000;
            padding: 20px 25px;
            font-size: 1.3em;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 15px;
            transition: all 0.3s ease;
        }

        .question:hover {
            padding-right: 35px;
        }

        .question::before {
            content: 'Q';
            background: #000;
            color: #d4af37;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            flex-shrink: 0;
        }

        .answer {
            background: rgba(78, 204, 163, 0.1);
            padding: 25px;
            color: #ccc;
            line-height: 1.9;
            font-size: 1.1em;
            border-top: 2px solid rgba(78, 204, 163, 0.3);
        }

        .answer::before {
            content: 'A';
            background: #4ecca3;
            color: #000;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            margin-left: 10px;
            float: right;
        }

        /* Tips Section */
        .tips-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin: 30px 0;
        }

        .tip-card {
            background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, rgba(78, 204, 163, 0.1) 100%);
            border: 2px solid #d4af37;
            border-radius: 20px;
            padding: 25px;
            position: relative;
            transition: all 0.4s ease;
        }

        .tip-card::before {
            content: '💡';
            position: absolute;
            top: -15px;
            right: 20px;
            font-size: 2em;
            background: #1a1a1a;
            padding: 5px 10px;
            border-radius: 50%;
        }

        .tip-card:hover {
            transform: translateY(-10px) rotate(2deg);
            box-shadow: 0 20px 50px rgba(212, 175, 55, 0.4);
            border-color: #4ecca3;
        }

        .tip-number {
            font-size: 2.5em;
            font-weight: 900;
            color: #4ecca3;
            margin-bottom: 15px;
        }

        .tip-content {
            color: #fff;
            line-height: 1.8;
            font-size: 1.05em;
        }

        /* Navigation Controls */
        .slide-controls {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin: 40px 0;
        }

        .control-btn {
            background: linear-gradient(135deg, #d4af37 0%, #f8e45f 100%);
            color: #000;
            border: none;
            padding: 15px 40px;
            border-radius: 50px;
            font-size: 1.2em;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
        }

        .control-btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(212, 175, 55, 0.6);
        }

        .control-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* Footer */
        .footer {
            background: linear-gradie
